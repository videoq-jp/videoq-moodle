{{!
    @template local_videoq/tags
    @copyright 2026 VideoQ contributors
    @license http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
    Opens course tags and filtering in the existing authenticated tool.

    Example context (json):
    {"heading": "Course tags and materials", "unavailable": "Course tags are unavailable."}
}}
<div id="videoq-course-tags" class="p-3 border-bottom bg-body" data-heading="{{heading}}" data-unavailable="{{unavailable}}" hidden>
    <details><summary aria-controls="videoq-questions">{{heading}}</summary></details>
    <p role="status" class="small text-danger mt-2 mb-0"></p>
</div>
