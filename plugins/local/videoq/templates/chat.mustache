    @template local_videoq/chat
    @copyright 2026 VideoQ contributors
    @license http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
    Native Moodle messaging UI with Moodle-session question delivery.

    Example context (json):
    {
        "heading": "AI assistant",
        "connectionerror": "Connection unavailable.",
        "seeksuffix": "Jump to",
        "feedbackgood": "Good",
        "feedbackbad": "Bad",
        "empty": "No questions yet.",
        "connecting": "Connecting...",
        "hint": "Ask a question about this course.",
        "questionmessage": false,
        "answermessage": false
    }
}}
<div id="videoq-native-chat" class="message-app" data-connection-error="{{connectionerror}}" data-seek-suffix="{{seeksuffix}}" aria-label="{{heading}}">
    <div id="videoq-native-messages" class="local-videoq-message-list d-flex flex-column p-3" role="log" aria-live="polite" aria-relevant="additions">
        <p id="videoq-native-empty" class="text-center text-muted my-auto">{{empty}}</p>
    </div>
    <div class="footer-container p-3 border-top bg-body">
        <p id="videoq-native-status" role="status" class="small text-muted mb-2">{{connecting}}</p>
        <form id="videoq-native-form">
            <fieldset id="videoq-native-controls" class="border-0 p-0 m-0" disabled>
                {{> core_message/message_drawer_view_conversation_footer_content }}
            </fieldset>
        </form>
        <p class="small text-muted mt-2 mb-0">{{hint}}</p>
    </div>
    <template id="videoq-native-question-template">
        {{#questionmessage}}{{> core_message/message_drawer_view_conversation_body_message }}{{/questionmessage}}
    </template>
    <template id="videoq-native-answer-template">
        {{#answermessage}}{{> core_message/message_drawer_view_conversation_body_message }}{{/answermessage}}
    </template>

<template id="videoq-native-feedback-template">
    <div class="d-flex align-items-center gap-1 pt-2" data-region="answer-feedback">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-feedback="good" aria-label="{{feedbackgood}}" aria-pressed="false">
            <i class="icon fa fa-thumbs-up fa-fw" aria-hidden="true"></i> {{feedbackgood}}
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-feedback="bad" aria-label="{{feedbackbad}}" aria-pressed="false">
            <i class="icon fa fa-thumbs-down fa-fw" aria-hidden="true"></i> {{feedbackbad}}
        </button>
        <small role="status" class="text-danger"></small>
    </div>
</template>

</div>
