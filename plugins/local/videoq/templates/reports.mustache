<details class="local-videoq-tool p-3 border-bottom" id="videoq-course-reports" hidden><summary>{{#str}}nativereports_title, local_videoq{{/str}}</summary><p>{{#str}}nativereports_notice, local_videoq{{/str}}</p>
<form id="videoq-reports-form"><label>{{#str}}nativereports_from, local_videoq{{/str}}<input class="form-control" id="videoq-reports-from" type="date" required></label><label>{{#str}}nativereports_to, local_videoq{{/str}}<input class="form-control" id="videoq-reports-to" type="date" required></label>
<button type="submit" class="btn btn-outline-secondary btn-sm">{{#str}}nativereports_load, local_videoq{{/str}}</button><button id="videoq-reports-export" type="button" class="btn btn-outline-secondary btn-sm" disabled>{{#str}}nativereports_csv, local_videoq{{/str}}</button>
<button id="videoq-reports-close" type="button" class="btn btn-outline-secondary btn-sm" hidden>{{#str}}nativereports_close, local_videoq{{/str}}</button></form><p id="videoq-reports-status" role="status" aria-live="polite"></p><div id="videoq-reports-content"></div></details>
