{{!
    @template local_videoq/reports
    @copyright 2026 VideoQ contributors
    @license http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
    Opens course usage reports in the existing authenticated tool.

    Example context (json):
    {"heading": "AI question usage", "unavailable": "Course reports are unavailable."}
}}
<div id="videoq-course-reports" class="p-3 border-bottom bg-body" data-heading="{{heading}}" data-unavailable="{{unavailable}}" hidden>
    <details><summary aria-controls="videoq-questions">{{heading}}</summary></details>
    <p role="status" class="small text-danger mt-2 mb-0"></p>
</div>
