# Isolated Moodle lab. Configure VideoQ separately; never use these credentials in production.
MOODLE_SOURCE=/tmp/videoq-lti-moodle-source
MOODLE_INTEGRATION_ROOT=..
LTI_LAB_DIR=/tmp/videoq-lti-lab
# External VideoQ services reachable from the lab Docker network.
VIDEOQ_API_UPSTREAM=api:8787
VIDEOQ_WEB_UPSTREAM=web:80
VIDEOQ_STORAGE_UPSTREAM=garage:3900
