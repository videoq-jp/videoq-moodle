{
    auto_https disable_redirects
}
https://moodle.localhost:18443 {
    tls internal
    reverse_proxy moodle:80
}
https://videoq.localhost:18443 {
    tls internal
    @api path /api/* /health /ready /.well-known/*
    handle @api {
        reverse_proxy {$VIDEOQ_API_UPSTREAM}
    }
    handle {
        reverse_proxy {$VIDEOQ_WEB_UPSTREAM}
    }
}
https://storage.videoq.localhost:18443 {
    tls internal
    reverse_proxy {$VIDEOQ_STORAGE_UPSTREAM}
}
